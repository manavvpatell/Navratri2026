{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "Garba event registration pass and QR token data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique purchase or pass ID" },
        "name": { "type": "string", "description": "Customer's full name" },
        "email": { "type": "string", "description": "Customer's registration email" },
        "phone": { "type": "string", "description": "Customer's phone contact" },
        "day": { "type": "integer", "description": "The Navratri day (1-9) booked" },
        "ticketHash": { "type": "string", "description": "Unique cryptographic QR identifier" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"], "description": "Transaction status" },
        "amount": { "type": "number", "description": "Total payment in INR" },
        "orderId": { "type": "string", "description": "Razorpay order reference ID" },
        "paymentId": { "type": "string", "description": "Razorpay payment transaction ID" },
        "paymentSignature": { "type": "string", "description": "Razorpay payment authorization signature" },
        "createdAt": { "type": "string", "description": "RFC3339 Timestamp of creation" },
        "isScanned": { "type": "boolean", "description": "Whether ticket has been validated at gate" }
      },
      "required": ["id", "name", "email", "phone", "day", "ticketHash", "status", "amount", "orderId", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security audit and transaction log for trace auditing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry identifier" },
        "timestamp": { "type": "string", "description": "RFC3339 Timestamp of event" },
        "level": { "type": "string", "enum": ["info", "warning", "error", "security"], "description": "Log severity level" },
        "event": { "type": "string", "description": "Named activity label" },
        "details": { "type": "string", "description": "Detailed payload or activity context parameters" },
        "email": { "type": "string", "description": "Authorized email identifier responsible" }
      },
      "required": ["id", "timestamp", "level", "event", "details", "email"]
    },
    "CapacityState": {
      "title": "CapacityState",
      "description": "Capacity ledger for each Navratri day to prevent overselling",
      "type": "object",
      "properties": {
        "day": { "type": "integer", "description": "Day value (1-9)" },
        "maxCapacity": { "type": "integer", "description": "Maximum permit limit" },
        "currentCapacity": { "type": "integer", "description": "Currently sold count" }
      },
      "required": ["day", "maxCapacity", "currentCapacity"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "System announcements, venue updates, and successful order alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Alert entry ID" },
        "title": { "type": "string", "description": "Notification heading title" },
        "body": { "type": "string", "description": "Notification description context" },
        "type": { "type": "string", "enum": ["update", "success", "alert", "info"], "description": "Notification classification class" },
        "timestamp": { "type": "string", "description": "RFC3339 Timestamp" },
        "read": { "type": "boolean", "description": "Read / Unread state indicator" }
      },
      "required": ["id", "title", "body", "type", "timestamp", "read"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "Booking" },
      "description": "Secure Garba Pass booking tickets repository"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Read-only system audit log entries for accounting"
    },
    "/capacity_state/{dayId}": {
      "schema": { "$ref": "CapacityState" },
      "description": "Day-by-day atomic real-time capacity ticket ledgers"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "UserNotification" },
      "description": "Real-time user venue update push notifications feed"
    }
  }
}
